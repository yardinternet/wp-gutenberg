{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yard/timeline",
	"version": "0.2.0",
	"title": "Tijdlijn",
	"category": "yard",
	"description": "Creeërt een tijdlijn wrapper waarbij elk blokje een nieuwe stap is.",
	"attributes": {
		"isOrderedList": {
			"type": "boolean",
			"default": false
		},
		"headingLevel": {
			"type": "string",
			"default": "h3"
		}
	},
	"supports": {
		"align": [ "wide" ],
		"color": {
			"background": true,
			"text": true
		},
		"contentRole": true,
		"html": false,
		"listView": true
	},
	"textdomain": "yard",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
